{
  "name": "errand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "dev:sim": "node scripts/run-sim.cjs dev --webpack",
    "build:sim": "node scripts/run-sim.cjs build --webpack",
    "start:sim": "node scripts/run-sim.cjs start",
