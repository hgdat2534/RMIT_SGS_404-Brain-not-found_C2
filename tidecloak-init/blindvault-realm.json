{
  "id": "blindvault-realm",
  "realm": "blindvault-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "_tide_message.selfencrypt",
        "description": "TideCloak tag role to encrypt candidate identity payloads"
      },
      {
        "name": "_tide_message.selfdecrypt",
        "description": "TideCloak tag role to decrypt candidate identity payloads once quorum aligns"
      },
      {
        "name": "committee_judge",
        "description": "BlindVault Quorum Judge"
      }
    ]
  },
  "defaultRoles": [
    "_tide_message.selfencrypt",
    "_tide_message.selfdecrypt",
    "committee_judge"
  ],
  "clients": [
    {
      "clientId": "blindvault-client",
      "name": "BlindVault Next.js Confidential & Public Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "blindvault-secret-2026",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/auth/redirect"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "*"
      ]
    }
  ],
